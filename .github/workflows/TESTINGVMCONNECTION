name: Test Azure VM PowerShell Connection

on:
  workflow_dispatch:   # You can run this manually

jobs:
  test-connection:
    runs-on: windows-latest   # ✅ Use Windows runner

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Login to Azure
        uses: azure/login@v2
        with:
          creds: ${{ secrets.AZURE_CREDENTIALS }}

      - name: Test PowerShell Remoting to Azure VM
        run: |
          Write-Host "🔍 Testing connection to Azure VM..."

          $username = "${{ secrets.VM_USERNAME }}"
          $password = ConvertTo-SecureString "${{ secrets.VM_PASSWORD }}" -AsPlainText -Force
          $cred = New-Object System.Management.Automation.PSCredential ($username, $password)
          $vmIP = "${{ secrets.VM_PUBLIC_IP }}"

          # Try to create a remote PowerShell session
          try {
              $session = New-PSSession -ComputerName $vmIP -Credential $cred -UseSSL -SessionOption (New-PSSessionOption -SkipCACheck -SkipCNCheck)
              Write-Host "Successfully connected to VM: $vmIP"
              
              # Test running a simple command
              $result = Invoke-Command -Session $session -ScriptBlock { hostname }
              Write-Host " Remote VM hostname: $result"
              
              Remove-PSSession $session
          }
          catch {
              Write-Host " Connection failed!"
              Write-Host "Error: $($_.Exception.Message)"
              exit 1
          }
